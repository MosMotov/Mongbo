{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PLUGIN_ROOT, 'hooks/bootstrap.cjs'))\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PLUGIN_ROOT, 'hooks/bootstrap.cjs'))\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
